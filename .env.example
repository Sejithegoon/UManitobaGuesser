# UManitoba Guesser - environment template
# Copy to `.env` (git-ignored) and fill in locally. NEVER commit real values.
# The website itself is static and does not read this file; it is for the
# Supabase CLI, psql and local scripts.

# ---------------------------------------------------------------------
# PUBLIC values - safe to ship in browser code (Phase 3 will put these in
# static/config.js). Access is limited by RLS, not by keeping them secret.
# ---------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------
# PRIVATE values - local machine / CI secrets only. Never in the browser,
# never in the repository, never pasted into chat.
# ---------------------------------------------------------------------
# Project reference (the "xxxx" in https://xxxx.supabase.co) for `supabase link`
SUPABASE_PROJECT_REF=your-project-ref

# Postgres connection string (contains the database password).
# Dashboard > Connect > Session pooler.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:YOUR-DB-PASSWORD@aws-0-ca-central-1.pooler.supabase.com:5432/postgres

# Personal access token for the Supabase CLI (account settings > Access Tokens)
SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Server-side secret key (bypasses RLS). NOT needed in Phase 2.
# Later used only inside Supabase Edge Functions, where Supabase provides it.
# SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
